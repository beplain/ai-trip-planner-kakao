# 이 파일을 .env.local 로 복사해 값을 채우세요. (EXPO_PUBLIC_ 값은 앱에 포함되므로 비밀키 금지)

# 백엔드 주소 (호스트만, 끝에 /api 붙이지 않음)
#  - 카카오 로그인을 쓰려면 휴대폰 브라우저에서 접근 가능한 https 주소 권장 (ngrok)
#  - 에뮬레이터 + 개발용 로그인만 쓸 때: http://10.0.2.2:8080
EXPO_PUBLIC_API_BASE_URL=https://YOUR-DOMAIN.ngrok-free.app

# 카카오 JavaScript 키 (지도 표시용). 카카오 콘솔 [플랫폼 > Web]에 http://localhost 등록 필요
# REST API 키는 여기에 넣지 마세요(서버 전용).
EXPO_PUBLIC_KAKAO_JS_KEY=

# 개발용 로그인 버튼 표시 여부 (배포 시 false)
EXPO_PUBLIC_DEV_LOGIN=true
